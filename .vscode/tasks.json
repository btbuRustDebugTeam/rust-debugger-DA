{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "cargo build (minimal)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/testcases/minimal"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "embassy-std: build tick",
      "type": "shell",
      "command": "./build_examples.sh tick",
      "options": {
        "cwd": "${workspaceFolder}/testcases/embassy-std"
      },
      "problemMatcher": []
    },
    {
      "label": "embassy-std: gen whitelist",
      "type": "shell",
      "command": "./gen_whitelist.sh tick",
      "options": {
        "cwd": "${workspaceFolder}/testcases/embassy-std"
      },
      "problemMatcher": []
    },
    {
      "label": "embassy-std: start gdbserver tick",
      "type": "shell",
      "command": "./run_example_gdbserver.sh tick 1234",
      "options": {
        "cwd": "${workspaceFolder}/testcases/embassy-std"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "lilos: start qemu",
      "type": "shell",
      "command": "echo '[LILOS] Manual mode: cd testcases/lilos_src && ./run_lilos.sh qemu 1234'",
      "problemMatcher": []
    },
    {
      "label": "lilos: gen whitelist",
      "type": "shell",
      "command": "bash testcases/lilos_src/gen_whitelist.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "lilos: gdb attach",
      "type": "shell",
      "command": "gdb-multiarch /home/user/lilos/target/thumbv7m-none-eabi/debug/lilos-testsuite-lm3s6965",
      "options": {
        "cwd": "${workspaceFolder}/testcases/lilos_src"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
