{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Extension Development Host (with testcase)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/testcases/minimal"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug Adapter Server (调试调试器)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/debugAdapterStandalone.js",
      "args": [
        "--server=4711"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/async_rust_debugger",
        "ARDB_TEMP_DIR": "${workspaceFolder}/temp"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Debug Adapter (standalone, full)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/debugAdapterStandalone.js",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/async_rust_debugger",
        "ARDB_TEMP_DIR": "${workspaceFolder}/temp"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "npm: compile"
    }
  ],
  "compounds": [
    {
      "name": "Extension + Adapter Server (调试调试器)",
      "configurations": [
        "Extension Development Host",
        "Debug Adapter Server (调试调试器)"
      ],
      "stopAll": true,
      "preLaunchTask": "npm: compile"
    }
  ]
}
